{
  "projectId": "<PROJECT_ID>",
  "endpoint": "https://appwrite.edgez.ai/v1",
  "authMethods": [
    { "$id": "email-password", "name": "Email and password", "enabled": true },
    { "$id": "jwt", "name": "JWT", "enabled": true },
    { "$id": "anonymous", "name": "Anonymous sessions", "enabled": false }
  ],
  "platforms": [
    {
      "$id": "live-stocking-web",
      "name": "Live Stocking web",
      "type": "web",
      "hostname": "{siteDomain:live-stocking}"
    },
    {
      "$id": "live-stocking-local",
      "name": "Live Stocking local web",
      "type": "web",
      "hostname": "localhost"
    },
    {
      "$id": "live-stocking-android",
      "name": "Live Stocking Android",
      "type": "android",
      "applicationId": "biz.edgez.live_stocking"
    }
  ],
  "tablesDB": [
    {
      "$id": "live-stocking",
      "name": "Live Stocking",
      "enabled": true
    }
  ],
  "tables": [
    {
      "$id": "farms",
      "databaseId": "live-stocking",
      "name": "Farms",
      "permissions": ["create(\"users\")"],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "name", "type": "varchar", "size": 128, "required": true, "array": false },
        { "key": "country", "type": "varchar", "size": 2, "required": true, "array": false },
        { "key": "location", "type": "varchar", "size": 128, "required": true, "array": false },
        { "key": "halowChannel", "type": "integer", "required": true, "array": false },
        { "key": "meshId", "type": "varchar", "size": 32, "required": true, "array": false },
        { "key": "meshPassphrase", "type": "varchar", "size": 63, "required": true, "array": false, "encrypt": true },
        { "key": "teamId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "ownerId", "type": "varchar", "size": 36, "required": true, "array": false }
      ],
      "indexes": [
        { "key": "team-id", "type": "key", "attributes": ["teamId"] }
      ]
    },
    {
      "$id": "telemetry",
      "databaseId": "live-stocking",
      "name": "Telemetry",
      "permissions": [],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "deviceId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "serial", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "channel", "type": "varchar", "size": 160, "required": true, "array": false },
        { "key": "topic", "type": "varchar", "size": 320, "required": true, "array": false },
        { "key": "payload", "type": "varchar", "size": 10000, "required": true, "array": false },
        { "key": "receivedAt", "type": "varchar", "size": 40, "required": true, "array": false }
      ],
      "indexes": [
        { "key": "received-at", "type": "key", "attributes": ["receivedAt"], "orders": ["DESC"] },
        { "key": "device-id", "type": "key", "attributes": ["deviceId"] },
        { "key": "device-history", "type": "key", "attributes": ["deviceId", "receivedAt"], "orders": ["ASC", "ASC"] }
      ]
    },
    {
      "$id": "topology-links",
      "databaseId": "live-stocking",
      "name": "Topology links",
      "permissions": [],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "farmId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "gatewayDeviceId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "gatewaySerial", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "peerDeviceId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "peerSerial", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "peerRadioMac", "type": "varchar", "size": 17, "required": true, "array": false },
        { "key": "rssi", "type": "integer", "required": false, "array": false, "min": -127, "max": 0 },
        { "key": "active", "type": "boolean", "required": true, "array": false },
        { "key": "lastSeenAt", "type": "varchar", "size": 40, "required": true, "array": false },
        { "key": "reportedAt", "type": "varchar", "size": 40, "required": true, "array": false }
      ],
      "indexes": [
        { "key": "gateway-peer", "type": "unique", "attributes": ["gatewayDeviceId", "peerDeviceId"] },
        { "key": "gateway-id", "type": "key", "attributes": ["gatewayDeviceId"] },
        { "key": "farm-active", "type": "key", "attributes": ["farmId", "active"] },
        { "key": "active-reported", "type": "key", "attributes": ["active", "reportedAt"], "orders": ["ASC", "DESC"] }
      ]
    },
    {
      "$id": "geofence-areas",
      "databaseId": "live-stocking",
      "name": "Geofence areas",
      "permissions": ["create(\"users\")"],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "farmId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "name", "type": "varchar", "size": 128, "required": true, "array": false },
        { "key": "shape", "type": "varchar", "size": 12, "required": true, "array": false },
        { "key": "geometry", "type": "varchar", "size": 4000, "required": true, "array": false }
      ]
    },
    {
      "$id": "geofence-rules",
      "databaseId": "live-stocking",
      "name": "Geofence rules",
      "permissions": ["create(\"users\")"],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "farmId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "name", "type": "varchar", "size": 128, "required": true, "array": false },
        { "key": "areaId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "deviceIds", "type": "varchar", "size": 36, "required": false, "array": true },
        { "key": "enterAlert", "type": "boolean", "required": true, "array": false },
        { "key": "exitAlert", "type": "boolean", "required": true, "array": false }
      ],
      "indexes": [
        { "key": "farm-id", "type": "key", "attributes": ["farmId"] }
      ]
    },
    {
      "$id": "geofence-alarms",
      "databaseId": "live-stocking",
      "name": "Geofence alarms",
      "permissions": [],
      "rowSecurity": true,
      "enabled": true,
      "columns": [
        { "key": "farmId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "areaId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "ruleId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "deviceId", "type": "varchar", "size": 36, "required": true, "array": false },
        { "key": "event", "type": "varchar", "size": 8, "required": true, "array": false },
        { "key": "active", "type": "boolean", "required": true, "array": false },
        { "key": "acknowledged", "type": "boolean", "required": true, "array": false },
        { "key": "lastLocation", "type": "varchar", "size": 128, "required": true, "array": false },
        { "key": "raisedAt", "type": "varchar", "size": 40, "required": true, "array": false },
        { "key": "clearedAt", "type": "varchar", "size": 40, "required": false, "array": false },
        { "key": "acknowledgedAt", "type": "varchar", "size": 40, "required": false, "array": false }
      ],
      "indexes": [
        { "key": "farm-active", "type": "key", "attributes": ["farmId", "active"], "orders": ["ASC", "ASC"] },
        { "key": "rule-device-event", "type": "unique", "attributes": ["ruleId", "deviceId", "event"] }
      ]
    }
  ],
  "buckets": [],
  "functions": [
    {
      "$id": "live-stocking",
      "name": "Live Stocking MQTT ingest",
      "runtime": "node-24",
      "path": "function",
      "entrypoint": "src/main.js",
      "commands": "npm ci",
      "execute": [],
      "events": ["devices.*.mqtt.message.publish"],
      "schedule": "",
      "timeout": 15,
      "enabled": true,
      "logging": true,
      "runtimeSpecification": "s-1vcpu-2gb",
      "scopes": ["devices.read", "rows.read", "rows.write"],
      "vars": [
        { "key": "LIVE_STOCKING_DATABASE_ID", "value": "live-stocking" },
        { "key": "LIVE_STOCKING_TELEMETRY_TABLE_ID", "value": "telemetry" },
        { "key": "LIVE_STOCKING_TOPOLOGY_TABLE_ID", "value": "topology-links" },
        { "key": "LIVE_STOCKING_GEOFENCE_AREA_TABLE_ID", "value": "geofence-areas" },
        { "key": "LIVE_STOCKING_GEOFENCE_RULE_TABLE_ID", "value": "geofence-rules" },
        { "key": "LIVE_STOCKING_GEOFENCE_ALARM_TABLE_ID", "value": "geofence-alarms" }
      ]
    }
  ],
  "sites": [
    {
      "$id": "live-stocking",
      "name": "Live Stocking",
      "framework": "nextjs",
      "buildRuntime": "node-24",
      "buildSpecification": "s-1vcpu-2gb",
      "adapter": "static",
      "path": "site",
      "enabled": true,
      "logging": true,
      "timeout": 30,
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "out",
      "fallbackFile": "index.html",
      "vars": [
        { "key": "LIVE_STOCKING_ENDPOINT", "value": "https://appwrite.edgez.ai/v1" },
        { "key": "LIVE_STOCKING_DATABASE_ID", "value": "live-stocking" },
        { "key": "LIVE_STOCKING_TELEMETRY_TABLE_ID", "value": "telemetry" },
        { "key": "LIVE_STOCKING_TOPOLOGY_TABLE_ID", "value": "topology-links" }
      ]
    }
  ]
}
